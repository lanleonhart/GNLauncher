<Window x:Class="GNLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GNLauncher"
        Height="600"
        Width="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- Background image with zoom -->
        <Image Source="Assets/wallpaper.jpg"
               Stretch="Fill"
               RenderTransformOrigin="0.5,0.5"
               Panel.ZIndex="-1">
            <Image.LayoutTransform>
                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
            </Image.LayoutTransform>
        </Image>

        <!-- Logo -->
        <Image Source="Assets/uixTxr_landingLogo.png"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Width="500"
               Height="100"
               Margin="0,20,0,0"
               Panel.ZIndex="1"/>

        <!-- STEP: Select EXE -->
        <StackPanel x:Name="step_select_exe"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="400"
                    Margin="0,0,0,20">
            <TextBox x:Name="textBox_exe_loc"
                     Height="30"
                     Text="Select BattleTech.exe location..."
                     Margin="0,5"/>
            <Button x:Name="button_browse"
                    Height="30"
                    Content="Select EXE"
                    Click="button_browse_Click"
                    Margin="0,5"/>
            <Button x:Name="button_start_install"
                    Height="30"
                    Content="Start Install"
                    IsEnabled="False"
                    Click="button_start_install_Click"
                    Margin="0,5"/>
        </StackPanel>

        <!-- STEP: Downloading -->
        <StackPanel x:Name="step_downloading"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,100"
                    Width="400">
            <ProgressBar x:Name="progressTotal" Height="20" Margin="0,5"/>
            <ProgressBar x:Name="progressCurrent" Height="20" Margin="0,5"/>
            <Label x:Name="label_current_file" Content=""/>
            <TextBlock x:Name="tb_progress" Text="0%" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- STEP: Installing -->
        <StackPanel x:Name="step_installing"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,60"
                    Width="400">
            <Label x:Name="lblInstall" Content="Installing..."/>
            <ProgressBar x:Name="installProgressTotal" Height="20" Margin="0,5"/>
            <TextBlock x:Name="tb_installProgress" Text="0/0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- STEP: Done -->
        <StackPanel x:Name="step_done"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20">
            <Button Content="Open Log Folder" Click="button_open_log_Click" Margin="0,5" Width="150"/>
            <Button Content="Exit" Click="btnExit_Click" Width="150"/>
        </StackPanel>

        <!-- 🚫 Removed credit text -->

    </Grid>
</Window>
